<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Daily games in every time control against Stockfish levels, at 05:00 Dubai time (01:00 UTC), for at most 10 hours.
     Install: cp to ~/Library/LaunchAgents/ and `launchctl load` it. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.arhanpassant.gauntlet</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/arhancanli/arhanpassant/.venv/bin/python</string>
    <string>/Users/arhancanli/arhanpassant/forge/gauntlet.py</string>
    <string>--target</string>
    <string>100</string>
    <string>--hours</string>
    <string>10</string>
    <string>--concurrency</string>
    <string>3</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>5</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/arhancanli/arhanpassant-data/gauntlet/daily.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/arhancanli/arhanpassant-data/gauntlet/daily.log</string>
</dict>
</plist>
